# OBEY Platform Configuration

# --- Supabase (Auth & DB) ---
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Interswitch (VTU) ---
INTERSWITCH_CLIENT_ID=your_client_id
INTERSWITCH_CLIENT_SECRET=your_client_secret
INTERSWITCH_TERMINAL_ID=your_terminal_id
INTERSWITCH_BASE_URL=https://qa.interswitchng.com/quicktellerservice/api/v5
INTERSWITCH_PASSPORT_URL=https://passport-v2.k8.isw.la/passport/oauth/token

# --- Google Maps (Location Services) ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
