# OBEY Platform Configuration

# --- Supabase (Auth & DB) ---
# Frontend Variables (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend / Generic Supabase Variables
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- Postgres Connection Strings ---
POSTGRES_DATABASE=postgres
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_USER=postgres
POSTGRES_PRISMA_URL=your_prisma_url
POSTGRES_URL=your_postgres_url
POSTGRES_URL_NON_POOLING=your_non_pooling_url

# --- Interswitch (VTU) ---
INTERSWITCH_CLIENT_ID=your_client_id
INTERSWITCH_CLIENT_SECRET=your_client_secret
INTERSWITCH_TERMINAL_ID=your_terminal_id
INTERSWITCH_BASE_URL=https://qa.interswitchng.com/quicktellerservice/api/v5
INTERSWITCH_PASSPORT_URL=https://passport-v2.k8.isw.la/passport/oauth/token

# --- Google Maps (Location Services) ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- Backend Configuration ---
PORT=5001
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_uri
COINAPI_KEY=
